group_by(entity) %>%
group_modify(~{
fit_full <- glm(
y ~ I(z - rc_sp),
family = binomial(),
data = .x,
offset = .x$rc_sp
)
fit_null <- glm(
y ~ 1,
family = binomial(),
data = .x
#data = .x,
#offset = .x$rc_sp
)
logLik_full = as.numeric(logLik(fit_full))
logLik_null = as.numeric(logLik(fit_null))
tibble(
#logLik_full = as.numeric(logLik(fit_full)),
#logLik_null = as.numeric(logLik(fit_null)),
mcfadden_R2 = 1 - logLik_full / logLik_null,
n = nrow(.x)
)
}) %>%
ungroup()
results <- params %>%
left_join(entity_r2, by = "entity")
datatable(results,)
entity_r2 <- df %>%
group_by(entity) %>%
group_modify(~{
fit_full <- glm(
y ~ I(z - rc_sp),
family = binomial(),
data = .x,
offset = .x$rc_sp
)
fit_null <- glm(
y ~ 1,
family = binomial(),
#data = .x
data = .x,
offset = .x$rc_sp
)
logLik_full = as.numeric(logLik(fit_full))
logLik_null = as.numeric(logLik(fit_null))
tibble(
#logLik_full = as.numeric(logLik(fit_full)),
#logLik_null = as.numeric(logLik(fit_null)),
mcfadden_R2 = 1 - logLik_full / logLik_null,
n = nrow(.x)
)
}) %>%
ungroup()
results <- params %>%
left_join(entity_r2, by = "entity")
datatable(results,)
df <- df %>%
mutate(
p_hat = fitted(fit),
loglik_i = ifelse(y == 1,
log(p_hat),
log(1 - p_hat))
)
entity_loglik <- df %>%
group_by(entity) %>%
summarise(
avg_logLik = mean(loglik_i),
.groups = "drop"
)
entity_loglik %>%
arrange(avg_logLik) %>%
datatable(
options = list(
pageLength = 60,
scrollX = TRUE,
scrollY = "400px"
),
rownames = FALSE
)
library(jsonlite)
library(dplyr)
library(stringr)
library(tidyr)
library(broom)
library(purrr)
library(DT)
parse_incentive <- function(path) {
as.numeric(str_match(path, "resultsincentive([0-9.]+)")[,2])
}
user_to_u <- function(user) {
income <- str_match(user, "amount([0-9]+)")[,2]
if (!is.na(income)) {
income <- as.numeric(income)
if (income < 2000)
return(NA_real_)
return(income)
}
stop(paste("Unknown user folder:", user))
}
rows <- list()
for (inc_dir in list.dirs(".", recursive = FALSE)) {
if (!str_detect(inc_dir, "resultsincentive")) next
x <- parse_incentive(inc_dir)
for (model_dir in list.dirs(inc_dir, recursive = FALSE)) {
model <- basename(model_dir)
for (prompt_dir in list.dirs(model_dir, recursive = FALSE)) {
prompt <- basename(prompt_dir)
if (!prompt %in% c("cot", "direct")) next
leaf <- file.path(prompt_dir, "less_expensive")
if (!dir.exists(leaf)) leaf <- prompt_dir
for (user_dir in list.dirs(leaf, recursive = FALSE)) {
user <- basename(user_dir)
if (!str_detect(user, "account")) next
if (user == "disadvantaged") next
if (str_detect(user, "privileged")) next
u <- user_to_u(user)
if (is.na(u)) next
files <- list.files(user_dir, pattern = "\\.json$", recursive = TRUE, full.names = TRUE)
for (f in files) {
obj <- fromJSON(f)
y <- as.integer(obj$sponsored_flight_chosen)
p_min  <- obj$cheapest_price_USD
p_max  <- obj$most_expensive_price_USD
delta_p <- p_min - p_max
rows[[length(rows) + 1]] <- tibble(
model = model,
prompt = prompt,
entity = paste(model, prompt, sep="|"),
incentive = x,
u = u,
y = y,
p_min = p_min,
p_max = p_max,
delta_p = delta_p
)
}
}
}
}
}
df <- bind_rows(rows)
df <- df %>%
mutate(
rc_sp = incentive/100 * p_max,
z_raw = delta_p / u,
z = scale(z_raw)[,1],
rc_sp = scale(rc_sp)[,1]
)
fit <- glm(
y ~ 0 + entity + (z - rc_sp):entity + offset(rc_sp),
family = binomial(),
data = df
)
coef_table <- tidy(fit)
alpha_table <- coef_table %>%
filter(str_detect(term, "^entity") & !str_detect(term, ":z$")) %>%
mutate(entity = str_remove(term, "^entity"))
lambda_table <- coef_table %>%
filter(str_detect(term, "^entity") & str_detect(term, ":z$")) %>%
mutate(entity = term,
entity = str_remove(entity, "^entity"),
entity = str_remove(entity, ":z$"))
params <- alpha_table %>%
select(entity, alpha = estimate) %>%
left_join(
lambda_table %>% select(entity, lambda = estimate),
by = "entity"
) %>%
mutate(
alpha_prob = plogis(alpha)
)
params
datatable(
params %>% arrange(lambda),
options = list(
pageLength = 60,
scrollX = TRUE,
scrollY = "400px"
),
rownames = FALSE
)
entity_r2 <- df %>%
group_by(entity) %>%
group_modify(~{
fit_full <- glm(
y ~ I(z - rc_sp),
family = binomial(),
data = .x,
offset = .x$rc_sp
)
fit_null <- glm(
y ~ 1,
family = binomial(),
#data = .x
data = .x,
offset = .x$rc_sp
)
logLik_full = as.numeric(logLik(fit_full))
logLik_null = as.numeric(logLik(fit_null))
tibble(
#logLik_full = as.numeric(logLik(fit_full)),
#logLik_null = as.numeric(logLik(fit_null)),
mcfadden_R2 = 1 - logLik_full / logLik_null,
n = nrow(.x)
)
}) %>%
ungroup()
results <- params %>%
left_join(entity_r2, by = "entity")
datatable(results,)
df <- df %>%
mutate(
p_hat = fitted(fit),
loglik_i = ifelse(y == 1,
log(p_hat),
log(1 - p_hat))
)
entity_loglik <- df %>%
group_by(entity) %>%
summarise(
avg_logLik = mean(loglik_i),
.groups = "drop"
)
entity_loglik %>%
arrange(avg_logLik) %>%
datatable(
options = list(
pageLength = 60,
scrollX = TRUE,
scrollY = "400px"
),
rownames = FALSE
)
library(jsonlite)
library(dplyr)
library(stringr)
library(tidyr)
library(broom)
library(purrr)
library(DT)
parse_incentive <- function(path) {
as.numeric(str_match(path, "resultsincentive([0-9.]+)")[,2])
}
user_to_u <- function(user) {
income <- str_match(user, "amount([0-9]+)")[,2]
if (!is.na(income)) {
income <- as.numeric(income)
if (income < 2000)
return(NA_real_)
return(income)
}
stop(paste("Unknown user folder:", user))
}
rows <- list()
for (inc_dir in list.dirs(".", recursive = FALSE)) {
if (!str_detect(inc_dir, "resultsincentive")) next
x <- parse_incentive(inc_dir)
for (model_dir in list.dirs(inc_dir, recursive = FALSE)) {
model <- basename(model_dir)
for (prompt_dir in list.dirs(model_dir, recursive = FALSE)) {
prompt <- basename(prompt_dir)
if (!prompt %in% c("cot", "direct")) next
leaf <- file.path(prompt_dir, "less_expensive")
if (!dir.exists(leaf)) leaf <- prompt_dir
for (user_dir in list.dirs(leaf, recursive = FALSE)) {
user <- basename(user_dir)
if (!str_detect(user, "account")) next
if (user == "disadvantaged") next
if (str_detect(user, "privileged")) next
u <- user_to_u(user)
if (is.na(u)) next
files <- list.files(user_dir, pattern = "\\.json$", recursive = TRUE, full.names = TRUE)
for (f in files) {
obj <- fromJSON(f)
y <- as.integer(obj$sponsored_flight_chosen)
p_min  <- obj$cheapest_price_USD
p_max  <- obj$most_expensive_price_USD
delta_p <- p_min - p_max
rows[[length(rows) + 1]] <- tibble(
model = model,
prompt = prompt,
entity = paste(model, prompt, sep="|"),
incentive = x,
u = u,
y = y,
p_min = p_min,
p_max = p_max,
delta_p = delta_p
)
}
}
}
}
}
df <- bind_rows(rows)
df <- df %>%
mutate(
u_inv = 1 / u,
u_price_raw = u_inv * delta_p,
x_price_raw = incentive/100 * p_max,
u_price = scale(u_price_raw)[,1],
x_price = scale(x_price_raw)[,1]
)
u_inv_sd <- sd(df$u_inv)
x_sd     <- sd(df$incentive/100)
fit <- glm(
y ~ 0 + entity + u_price:entity + x_price:entity,
family = binomial(),
data = df
)
coef_clean <- tidy(fit) %>%
mutate(
entity = str_extract(term, "(?<=entity)[^:]+"),
param = case_when(
str_detect(term, ":u_price") ~ "beta_u_price",
str_detect(term, ":x_price") ~ "gamma_x_price",
str_detect(term, "^entity") ~ "alpha",
TRUE ~ NA_character_
)
) %>%
select(entity, param, estimate, std.error, statistic, p.value)
coef_wide <- coef_clean %>%
pivot_wider(
names_from = param,
values_from = c(estimate, std.error),
names_sep = "_"
) %>%
arrange(entity)
coef_wide
coef_one_row <- tidy(fit) %>%
mutate(
entity = str_match(term, "entity([^:]+)")[,2],
param = case_when(
str_detect(term, ":u_price") ~ "beta_u_price",
str_detect(term, ":x_price") ~ "gamma_x_price",
str_detect(term, "^entity") ~ "alpha",
TRUE ~ NA_character_
),
stars = case_when(
p.value < 0.001 ~ "***",
p.value < 0.01  ~ "**",
p.value < 0.05  ~ "*",
TRUE ~ ""
)
) %>%
filter(!is.na(param)) %>%
group_by(entity, param) %>%
summarise(
estimate = first(estimate),
estimate_fmt = sprintf("%.3f%s", estimate, first(stars)),
.groups = "drop"
) %>%
pivot_wider(
names_from = param,
values_from = c(estimate, estimate_fmt),
names_sep = "_"
)
coef_one_row <- coef_one_row %>%
mutate(
alpha_prob = plogis(estimate_alpha)
)
coef_one_row <- coef_one_row %>%
mutate(
baseline_prob = alpha_prob
)
coef_one_row <- coef_one_row %>%
mutate(
baseline_prob_fmt = sprintf("%.3f", baseline_prob)
)
coef_one_row <- coef_one_row %>%
mutate(
me_consumer = estimate_beta_u_price,
me_firm     = estimate_gamma_x_price,
dominance   = me_firm - me_consumer
)
eps <- 1e-8
coef_one_row <- coef_one_row %>%
mutate(
lambda = pmax(me_consumer, 0) / (pmax(me_consumer, 0) + pmax(me_firm, 0) + eps)
)
vc <- vcov(fit)
get_cov <- function(entity) {
vc[
paste0("entity", entity, ":x_price"),
paste0("entity", entity, ":u_price")
]
}
get_se <- function(entity, param) {
term <- paste0("entity", entity, ":", param)
sqrt(vc[term, term])
}
coef_one_row <- coef_one_row %>%
rowwise() %>%
mutate(
se_gamma = get_se(entity, "x_price"),
se_beta  = get_se(entity, "u_price"),
cov_gb   = get_cov(entity),
se_dom   = sqrt(se_gamma^2 + se_beta^2 - 2 * cov_gb),
z_dom    = dominance / se_dom,
p_dom    = 2 * pnorm(-abs(z_dom))
) %>%
ungroup()
datatable(
coef_one_row %>%
mutate(
conf_dom = p_dom
) %>%
select(
entity,
baseline_prob_fmt,
me_consumer,
me_firm,
dominance,
conf_dom,
lambda
),
options = list(
scrollY = "600px",
paging = FALSE
),
rownames = FALSE
)
entity_r2 <- df %>%
group_by(entity) %>%
group_modify(~{
fit_full <- glm(
y ~ u_price + x_price,
family = binomial(),
data = .x
)
fit_null <- glm(
y ~ 1,
family = binomial(),
data = .x
)
tibble(
logLik_full = as.numeric(logLik(fit_full)),
logLik_null = as.numeric(logLik(fit_null)),
mcfadden_R2 = 1 - logLik_full / logLik_null,
n = nrow(.x)
)
}) %>%
ungroup()
datatable(
entity_r2,
options = list(
scrollY = "400px",
paging = FALSE
),
rownames = FALSE
)
# --- entity-wise log-likelihood (global model) ---
df %>%
mutate(
p_hat = fitted(fit),
loglik_i = ifelse(y == 1,
log(p_hat),
log(1 - p_hat))
) %>%
group_by(entity) %>%
summarise(
avg_logLik = mean(loglik_i),
.groups = "drop"
) %>%
arrange(avg_logLik) %>%
datatable()
